[Tests]
  issues = '#0'
  design = 'ComputeDeformationGradient.md'

  # --------------------------------------------------------------------------
  # Heavy-F-bar reference / restart pair on TET10 elements.
  #
  # Tunings vs recover_remesh_tet10:
  #   nu = 0.49 (near-incompressible -> volumetric locking matters)
  #   final_velocity = 0.2 (4x deformation magnitude)
  #   end_time = 1.5
  #
  # The restart reads the F-bar corrected stretch tensor (stretch_tensor_fbar)
  # directly.
  # --------------------------------------------------------------------------

  [reference]
    type = CSVDiff
    input = 'reference.i'
    csvdiff = 'reference_fbar_out.csv'
    abs_zero = 1e-10
    rel_err = 1e-6
    requirement = 'The system shall run a near-incompressible J2 dynamic '
                  'plasticity problem on TET10 elements with significant '
                  'F-bar correction work and emit the QP fields needed for '
                  'recovery comparison.'
  []

  [restart_matches_reference]
    type = CSVDiff
    input = 'restart.i'
    csvdiff = 'restart_fbar_out.csv'
    prereq = 'reference'
    abs_zero = 1e-10
    rel_err = 1e-6
    requirement = 'The system shall continue the F-bar-heavy reference run '
                  'through SolutionUserObjectQP recovery on the same TET10 '
                  'mesh and reproduce the trajectory with volumetric-locking '
                  'correction active.'
  []
[]
