[Tests]
  issues = '#0'
  design = 'LargeDeformationJ2PlasticityCorrection.md ComputeDeformationGradient.md'

  # --------------------------------------------------------------------------
  # Stage 1: Reference simulation.
  # Runs a short dynamic J2-plasticity + temperature + phase-field problem on
  # a small HEX8 mesh and writes the QP material/tensor fields to Exodus.
  # --------------------------------------------------------------------------
  [reference]
    type = CSVDiff
    input = 'reference.i'
    csvdiff = 'reference_out.csv'
    abs_zero = 1e-10
    rel_err = 1e-6
    requirement = 'The system shall run a small dynamic J2-plasticity problem '
                  'with temperature and phase-field fracture and emit the QP '
                  'fields needed for recovery.'
  []

  # --------------------------------------------------------------------------
  # Stage 2: Restart simulation.
  # Re-runs on the SAME generated mesh using SolutionUserObjectQP to seed the
  # material state from reference_out.e.  Because centroid-to-centroid lookup
  # is exact on an identical mesh, the integrated psie_corr_active /
  # psip_active / effective_plastic_strain reported at INITIAL must match the
  # reference's final row to recovery tolerance.  Any drift is a bug in the
  # recovery machinery itself (polar_decomposition seeding, b_bar restoration,
  # rotation-tensor axis continuity, etc.).
  # --------------------------------------------------------------------------
  [restart_matches_reference]
    type = CSVDiff
    input = 'restart.i'
    csvdiff = 'restart_out.csv'
    prereq = 'reference'
    abs_zero = 1e-10
    rel_err = 1e-6
    requirement = 'The system shall reproduce the integrated elastic and '
                  'plastic strain energy densities and effective plastic '
                  'strain of a reference run when restarted on the same mesh '
                  'through SolutionUserObjectQP recovery.'
  []

  # --------------------------------------------------------------------------
  # Same pair, recovering F-bar from the raw stretch tensor instead of reading
  # stretch_tensor_fbar: the reference writes the raw stretch tensor, and the
  # restart either rebuilds F-bar from it once at the start
  # (recover_apply_fbar_to_U = true) or applies F-bar to the total deformation
  # gradient every step (recover_apply_fbar_to_total = true).
  # --------------------------------------------------------------------------
  [reference_raw_U]
    type = RunApp
    input = 'reference.i'
    cli_args = 'stretch=stretch_tensor out=reference_raw_U_out'
    requirement = 'The system shall emit the raw stretch tensor at the '
                  'quadrature points for recovery.'
  []
  [restart_raw_U]
    type = CSVDiff
    input = 'restart.i'
    cli_args = 'stretch=stretch_tensor fbar_from_raw_U=true '
               'recover_file=reference_raw_U_out_disp.e out=restart_raw_U_out'
    csvdiff = 'restart_raw_U_out.csv'
    prereq = 'reference_raw_U'
    abs_zero = 1e-10
    rel_err = 1e-6
    requirement = 'The system shall recover a volumetric-locking-corrected '
                  'deformation gradient from the raw stretch tensor by '
                  'rebuilding the F-bar correction on restart.'
  []
  [restart_fbar_total]
    type = CSVDiff
    input = 'restart.i'
    cli_args = 'stretch=stretch_tensor fbar_to_total=true '
               'recover_file=reference_raw_U_out_disp.e out=restart_fbar_total_out'
    csvdiff = 'restart_fbar_total_out.csv'
    prereq = 'reference_raw_U'
    abs_zero = 1e-10
    rel_err = 1e-6
    requirement = 'The system shall recover a volumetric-locking-corrected '
                  'deformation gradient from the raw stretch tensor by '
                  'applying the F-bar correction to the total deformation '
                  'gradient.'
  []
[]
